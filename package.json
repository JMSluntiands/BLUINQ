{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:watch": "vite build --watch",
        "dev": "npm run clean:hot && vite build --watch",
        "dev:hmr": "npm run dev",
        "dev:stack": "concurrently -k -n laravel,watch -c cyan,magenta \"php artisan serve\" \"npm run dev\"",
        "clean:hot": "node -e \"try { require('fs').unlinkSync('public/hot'); console.log('Removed public/hot'); } catch (e) { console.log('No public/hot file'); }\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@vitejs/plugin-react-swc": "^4.3.0",
        "lucide-react": "^1.7.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.14.0"
    }
}
